<Window x:Class="WpfApi.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="REST API клиент" Height="640" Width="1000"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Боковая панель: пользователи -->
        <Border Background="{StaticResource SurfaceBrush}" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Пользователи" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,12" Text="GET /users"/>
                    <Button Content="Загрузить" Click="LoadUsers_Click" Margin="0,0,0,12"/>
                </StackPanel>
                <ListBox x:Name="UsersList" Padding="0" SelectionChanged="UsersList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource Surface2Brush}">
                                    <TextBlock Text="{Binding Id}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Email}" Style="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Основная область: посты -->
        <DockPanel Grid.Column="1" Margin="20">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="PostsHeader" FontSize="20" FontWeight="Bold" Text="Посты: выберите пользователя"/>
                <TextBlock Style="{StaticResource Muted}" Text="GET /posts?userId=…"/>
            </StackPanel>

            <!-- Форма добавления -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Muted}" Text="Заголовок" Margin="0,0,0,4"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Text="Текст" Margin="8,0,0,4"/>
                    <TextBox Grid.Row="1" x:Name="TitleBox"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="BodyBox" Margin="8,0,0,0"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="＋ POST" Margin="8,0,0,0" Click="AddPost_Click"/>
                    <Button Grid.Row="1" Grid.Column="3" Content="✕ DELETE" Margin="8,0,0,0"
                            Style="{StaticResource GhostButton}" Click="DeletePost_Click"/>
                </Grid>
            </Border>

            <Border CornerRadius="12" ClipToBounds="True" Background="{StaticResource SurfaceBrush}" Padding="0,4">
                <DataGrid x:Name="PostsGrid" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="ЗАГОЛОВОК" Binding="{Binding Title}" Width="2*"/>
                        <DataGridTextColumn Header="ТЕКСТ" Binding="{Binding Body}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>

        <!-- Строка состояния -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource AccentPressBrush}" Padding="12,4">
            <TextBlock x:Name="StatusText" Foreground="White" FontSize="12.5" Text="Готово"/>
        </Border>
    </Grid>
</Window>
