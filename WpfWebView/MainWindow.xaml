<Window x:Class="WpfWebView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Браузер (WebView2)" Height="760" Width="1200"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Панель навигации -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButton}" Content="◀" Width="38" Click="Back_Click" ToolTip="Назад"/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="▶" Width="38" Margin="4,0,0,0"
                        Click="Forward_Click" ToolTip="Вперёд"/>
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="⟳" Width="38" Margin="4,0,0,0"
                        Click="Reload_Click" ToolTip="Обновить"/>
                <TextBox Grid.Column="3" x:Name="AddressBox" Margin="10,0" Background="{StaticResource BgBrush}"
                         KeyDown="AddressBox_KeyDown"/>
                <Button Grid.Column="4" Content="Перейти" Click="Go_Click"/>
                <Button Grid.Column="5" Style="{StaticResource GhostButton}" Content="C# ⇄ JS" Margin="6,0,0,0"
                        Click="SendToJs_Click" ToolTip="Открыть локальную страницу и обменяться сообщениями"/>
            </Grid>
        </Border>

        <!-- Строка состояния -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceBrush}" Padding="12,4">
            <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"/>
        </Border>

        <wv2:WebView2 x:Name="WebView" Source="https://www.bing.com"
                      DefaultBackgroundColor="#1E1E2E"/>
    </DockPanel>
</Window>
