<Window x:Class="WpfAutoUpdate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Автообновление" Height="460" Width="620"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel>
            <TextBlock Text="Центр обновлений" FontSize="26" FontWeight="Bold"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Проверка новых версий через AutoUpdater.NET"/>
        </StackPanel>

        <!-- Карточка с версией и настройками -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Width="44" Height="44">
                        <TextBlock Text="⬆" FontSize="22" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Muted}" Text="Установленная версия"/>
                        <TextBlock x:Name="VersionText" FontSize="18" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource Muted}" Margin="0,18,0,6" Text="Адрес файла update.xml"/>
                <TextBox x:Name="UrlBox"/>

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                    <CheckBox x:Name="SilentCheck" VerticalAlignment="Center"
                              Content="Своё окно вместо стандартного"/>
                    <Button DockPanel.Dock="Right" Content="Проверить обновления" Click="CheckButton_Click"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Журнал -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,6" Text="Журнал"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                     VerticalScrollBarVisibility="Auto"/>
        </DockPanel>
    </Grid>
</Window>
